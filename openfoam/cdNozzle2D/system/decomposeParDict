FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Optional parallel decomposition. The base case is small enough to run
// serially; keep this file as a starting point for larger studies.

numberOfSubdomains  4;
method              simple;

coeffs
{
    n           (4 1 1);
    delta       0.001;
}

