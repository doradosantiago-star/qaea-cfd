FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Velocity field. The inlet uses pressureInletOutletVelocity so that the
// direction is recovered from the local pressure gradient, which is the
// standard choice for totalPressure reservoirs.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (10 0 0);

boundaryField
{
    inlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (10 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    topWall
    {
        type            slip;
    }

    bottomWall
    {
        type            symmetryPlane;
    }

    frontAndBack
    {
        type            empty;
    }
}

